{
  "name": "gethomepage-intellisense",
  "displayName": "GetHomepage IntelliSense",
  "version": "0.1.4",
  "description": "YAML IntelliSense, autocompletion, validation and snippets for GetHomepage configuration files (settings, services, widgets, bookmarks, docker, kubernetes, proxmox).",
  "categories": [
    "Linters",
    "Other",
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "dashboard",
    "docker",
    "gethomepage",
    "homelab",
    "homepage",
    "kubernetes",
    "proxmox",
    "self-hosted",
    "yaml"
  ],
  "homepage": "https://github.com/nicolasaigner/gethomepage-intellisense#readme",
  "bugs": {
    "url": "https://github.com/nicolasaigner/gethomepage-intellisense/issues"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "Scott Page",
      "url": "https://github.com/scottpage"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nicolasaigner/gethomepage-intellisense"
  },
  "publisher": "gethomepage",
  "main": "./out/extension.js",
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish",
    "test": "tsx --test tests/*.test.ts",
    "compile": "tsc -p .",
    "check": "tsc --noEmit -p .",
    "prepackage": "npm run compile",
    "prepublish": "npm run compile",
    "lint": "oxlint src tests",
    "format": "oxfmt src tests package.json tsconfig.json",
    "format:check": "oxfmt --check src tests package.json tsconfig.json",
    "locale:add": "node scripts/add-locale.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^4.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "yaml-homepage",
        "aliases": [
          "YAML (GetHomepage)",
          "yaml-homepage"
        ],
        "extensions": [],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "yaml-homepage",
        "scopeName": "source.yaml-homepage",
        "path": "./syntaxes/yaml-homepage.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[yaml-homepage]": {
        "editor.quickSuggestions": {
          "other": true,
          "strings": true
        },
        "editor.suggest.showSnippets": true,
        "editor.snippetSuggestions": "top"
      }
    }
  },
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "extensionDependencies": [
    "redhat.vscode-yaml"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1a1a2e",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  }
}
